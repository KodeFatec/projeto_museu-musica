+  capacity?: number;
+}
+
+/** Artista com o resumo mostrado na tela inicial. */
+export interface ArtistSummary {
+  id: number;
+  name: string;
+  photoUrl?: string;
+  trackCount: number;
+  /** Gênero da música mais ouvida (ou a primeira) do artista. */
