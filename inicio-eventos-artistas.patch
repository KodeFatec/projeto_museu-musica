+  contactEmail?: string;
+  contactPhone?: string;
+}
+
+/** Dados de contato do museu (`museu`). */
+export interface Museum {
+  id: number;
+  name: string;
+  description?: string;
+  address?: string;
+  phone?: string;
+  email?: string;
+}
+
+export interface MuseumRoom {
