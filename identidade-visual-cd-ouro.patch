diff --git a/src/app/shared/cd-disc/cd-disc.component.css b/src/app/shared/cd-disc/cd-disc.component.css
new file mode 100644
index 0000000..47b2ac6
--- /dev/null
+++ b/src/app/shared/cd-disc/cd-disc.component.css
@@ -0,0 +1,99 @@
+:host {
+  display: block;
+  width: 100%;
+  aspect-ratio: 1;
+  container-type: inline-size; /* textos do selo escalam com cqw */
+}
+
+.disc {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  border-radius: 50%;
+}
+
+.platter {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+  /* policarbonato prateado */
+  background: conic-gradient(from 20deg, #e9ecef, #bfc5cc, #f6f7f9, #aab1ba, #eef0f3, #c4cad2, #e9ecef);
+  box-shadow: inset 0 0 0 0.8cqw #cfd4da, inset 0 0 12px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.12);
+  animation: platter-spin 6s linear infinite;
+}
+.platter.paused { animation-play-state: paused; }
+
+.disc--gold .platter {
+  background: conic-gradient(from 20deg, #efd596, #c59a45, #f6e7bd, #a97e2c, #efd596, #d8b062, #efd596);
+  box-shadow: inset 0 0 0 0.8cqw #b88a35, inset 0 0 12px rgba(90, 60, 10, 0.3), 0 0 0 1px rgba(138, 99, 30, 0.5);
+}
+
+/* área impressa (arte do CD) */
+.print {
+  width: 88%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: flex-start;
+  gap: 0.6cqw;
+  padding-top: 11cqw;
+  text-align: center;
+  line-height: 1.1;
+  /* recorte do anel interno (onde fica o hub) */
+  -webkit-mask: radial-gradient(circle, transparent 0 14cqw, #000 14.4cqw);
+  mask: radial-gradient(circle, transparent 0 14cqw, #000 14.4cqw);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
+}
+
+.line {
+  font-family: var(--font-text);
+  font-size: 3.2cqw;
+  opacity: 0.88;
+}
+.line--main {
+  font-family: var(--font-title);
+  font-size: 4.2cqw;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  opacity: 1;
+}
+
+/* anel de plástico transparente + furo */
+.hub {
+  position: absolute;
+  width: 28%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  background: radial-gradient(circle, rgba(255, 255, 255, 0.85) 0 45%, rgba(220, 224, 230, 0.7) 46% 100%);
+  border: 0.5cqw solid rgba(255, 255, 255, 0.7);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
+}
+.hole {
+  width: 38%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: var(--bg);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
+}
+
+/* reflexo parado (a luz não gira com o disco) */
+.shine {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  pointer-events: none;
+  background: conic-gradient(from 45deg, rgba(255, 255, 255, 0.35) 0deg, transparent 50deg, rgba(255, 255, 255, 0.5) 120deg,
+    transparent 190deg, rgba(255, 255, 255, 0.3) 240deg, transparent 300deg, rgba(255, 255, 255, 0.5) 360deg);
+  mix-blend-mode: soft-light;
+}
+
+@keyframes platter-spin {
+  to { transform: rotate(360deg); }
+}
