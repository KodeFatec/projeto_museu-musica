+    @if (explore.decades().length) {
+      <app-library-section title="Linhas do Tempo &amp; Décadas" subtitle="Gravações por década" minItem="100%" mobileItem="100%">
+        <app-filter-chips label="Década" [options]="decadeChips()" value="" (valueChange)="pickDecade($event)" />
+      </app-library-section>
+    }
