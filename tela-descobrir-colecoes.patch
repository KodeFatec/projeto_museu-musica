+    <p class="state">Carregando o acervo…</p>
+  }
+
+  <div class="sections">
+    @if (explore.featured().length) {
+      <app-library-section title="Explorar Coleções" subtitle="Décadas e instrumentos do acervo" [wrap]="true" minItem="18rem" mobileItem="100%">
+        @for (collection of explore.featured(); track collection.id; let i = $index) {
+          <app-collection-card [title]="collection.title" [count]="collection.count" [unit]="collection.unit" [tone]="i" (choose)="pickCollection(collection)" />
+        }
+      </app-library-section>
+    }
+
+    @if (explore.physical().length) {
+      <app-library-section title="Acervo Físico do Museu" subtitle="Formatos e itens catalogados" [wrap]="true" minItem="13rem" mobileItem="100%">
+        @for (item of explore.physical(); track item.id) {
+          <app-physical-card [item]="item" (choose)="pickPhysical(item)" />
+        }
+      </app-library-section>
+    }
