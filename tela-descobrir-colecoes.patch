+:host {
+  display: block;
+  min-width: 0;
+}
+
+.card {
+  --tone: #5b1425;
+  position: relative;
+  width: 100%;
+  min-height: 9.5rem;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: 1.1rem;
+  overflow: hidden;
+  border: 0;
+  border-radius: 1rem;
+  background: linear-gradient(135deg, var(--tone), color-mix(in srgb, var(--tone) 70%, #000));
+  text-align: left;
+  color: #fff;
+  cursor: pointer;
+  box-shadow: 0 8px 18px rgba(30, 25, 21, 0.18);
+  transition: transform 0.25s, box-shadow 0.25s;
+}
+.card:hover,
+.card:focus-visible {
+  transform: translateY(-3px);
+  box-shadow: 0 14px 26px rgba(30, 25, 21, 0.26);
+}
+.card[data-tone='0'] { --tone: #5b1425; }
+.card[data-tone='1'] { --tone: #1f5a44; }
+.card[data-tone='2'] { --tone: #a9650f; }
+.card[data-tone='3'] { --tone: #1b3466; }
+.card[data-tone='4'] { --tone: #3e1f4f; }
+.card[data-tone='5'] { --tone: #8e3f1e; }
+
+/* arte decorativa: sulcos de vinil saindo pelo canto */
+.art {
+  position: absolute;
+  right: -2.5rem;
+  bottom: -2.5rem;
+  width: 9rem;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background:
+    radial-gradient(circle, rgba(255, 255, 255, 0.18) 0 8%, transparent 9%),
+    repeating-radial-gradient(circle, rgba(255, 255, 255, 0.1) 0 2px, transparent 2px 7px);
+  transition: transform 0.6s;
+}
+.card:hover .art {
+  transform: rotate(40deg) scale(1.06);
+}
+
+.title {
+  position: relative;
+  font: 700 1.5rem/1.1 var(--font-title);
+  letter-spacing: 0.02em;
+  text-transform: uppercase;
+}
+.count {
+  position: relative;
+  margin-top: 0.3rem;
+  font: 400 0.8rem var(--font-text);
+  opacity: 0.85;
+}
+.cta {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  margin-top: auto;
+  padding-top: 1rem;
+  font: 700 0.7rem var(--font-text);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.cta svg {
+  width: 0.95rem;
+}
+
+@media (min-width: 1024px) {
+  .card {
+    min-height: 14rem;
+    padding: 1.7rem;
+    border-radius: 1.1rem;
+  }
+  .art {
+    right: -3rem;
+    bottom: -3rem;
+    width: 15rem;
+  }
+  .title {
+    font-size: 2.6rem;
+  }
+  .count {
+    font-size: 0.95rem;
+  }
+}
