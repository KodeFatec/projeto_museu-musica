+<article class="card" [class.card--grid]="view() === 'grid'">
+  <div class="photo">
+    @if (instrument().photoUrl) {
+      <img [src]="instrument().photoUrl" [alt]="instrument().title" loading="lazy" />
+    } @else {
+      <svg class="photo__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+        <path d="M9 18V5l11-2v13M9 18a2.5 2.5 0 1 1-2.5-2.5A2.5 2.5 0 0 1 9 18Zm11-2a2.5 2.5 0 1 1-2.5-2.5A2.5 2.5 0 0 1 20 16Z" />
+      </svg>
+    }
+    @if (instrument().year) {
+      <span class="photo__year">{{ instrument().year }}</span>
+    }
+  </div>
+
+  <div class="body">
+    <p class="eyebrow">
+      @if (instrument().type) {
+        <span class="tag">{{ instrument().type }}</span>
+      }
+      <span class="code">{{ code() }}</span>
+    </p>
+    <h3 class="title">{{ instrument().title }}</h3>
+    @if (meta()) {
+      <p class="meta">{{ meta() }}</p>
+    }
+    @if (instrument().description) {
+      <p class="desc">{{ instrument().description }}</p>
+    }
+  </div>
+
+  <div class="side">
+    @if (instrument().condition) {
+      <span class="chip">{{ instrument().condition }}</span>
+    }
+    @if (facts().length) {
+      <ul class="facts">
+        @for (fact of facts(); track fact) {
+          <li>{{ fact }}</li>
+        }
+      </ul>
+    }
+  </div>
+</article>
