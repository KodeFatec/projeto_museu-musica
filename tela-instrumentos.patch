+import { dateRange } from '../../../../core/utils/date-format';
+
+/**
+ * Instrumento do acervo, em linha (catálogo) ou em cartão (galeria).
+ * Ainda não abre detalhes: quando a tela de detalhe existir, o evento `choose` já está pronto.
+ */
+@Component({
+  selector: 'app-instrument-card',
+  standalone: false,
+  templateUrl: './instrument-card.component.html',
+  styleUrl: './instrument-card.component.css',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class InstrumentCardComponent {
+  readonly instrument = input.required<Instrument>();
+  readonly view = input<InstrumentView>('list');
+  readonly choose = output<Instrument>();
+
+  /** "#ITEM-004" (id do item_acervo). */
+  protected readonly code = computed(() => `#ITEM-${String(this.instrument().id).padStart(3, '0')}`);
+  /** "Ano 1964 • Del Vecchio" */
+  protected readonly meta = computed(() => {
+    const { year, maker } = this.instrument();
+    return [year ? `Ano ${year}` : null, maker].filter(Boolean).join(' • ');
+  });
+  protected readonly facts = computed(() => {
+    const { acquiredAt, origin, formerOwner } = this.instrument();
+    return [
+      acquiredAt ? `Adquirido em ${dateRange(acquiredAt)}` : null,
+      origin ? `Origem: ${origin}` : null,
+      formerOwner ? `Antigo dono: ${formerOwner}` : null,
+    ].filter((f): f is string => !!f);
+  });
+}
