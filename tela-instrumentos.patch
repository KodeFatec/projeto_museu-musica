+import { ChangeDetectionStrategy, Component, computed, inject, OnInit } from '@angular/core';
+import { HomeService } from '../../core/services/home.service';
+import { InstrumentSort, InstrumentsService, InstrumentView } from '../../core/services/instruments.service';
+import { LibraryService } from '../../core/services/library.service';
+import { ChipOption } from '../../shared/filter-chips/filter-chips.component';
+
+/** Tela "Instrumentos": listagem do acervo de instrumentos (instrumento + item_acervo). */
+@Component({
+  selector: 'app-instruments',
+  standalone: false,
+  templateUrl: './instruments.component.html',
+  styleUrl: './instruments.component.css',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class InstrumentsComponent implements OnInit {
+  protected readonly instruments = inject(InstrumentsService);
+  protected readonly library = inject(LibraryService);
+  protected readonly home = inject(HomeService);
+
+  protected readonly sorts: { id: InstrumentSort; label: string }[] = [
+    { id: 'name', label: 'Nome (A–Z)' },
+    { id: 'oldest', label: 'Mais antigos primeiro' },
+    { id: 'newest', label: 'Mais recentes primeiro' },
+    { id: 'maker', label: 'Fabricante (A–Z)' },
+  ];
+  protected readonly views: { id: InstrumentView; label: string }[] = [
+    { id: 'list', label: 'Catálogo' },
+    { id: 'grid', label: 'Galeria' },
+  ];
+
+  protected readonly chips = computed<ChipOption[]>(() => [
+    { id: 'all', label: 'Todos os Instrumentos', count: this.instruments.all().length },
+    ...this.instruments.types().map((t) => ({ id: t.type, label: t.type, count: t.count })),
+  ]);
+
+  ngOnInit(): void {
+    void this.instruments.load();
+    void this.home.load();
+  }
+
+  protected onType(id: string): void {
+    this.instruments.type.set(id === 'all' ? null : id);
+  }
+
+  protected onSort(event: Event): void {
+    this.instruments.sort.set((event.target as HTMLSelectElement).value as InstrumentSort);
+  }
+
+  protected onSearch(query: string): void {
+    this.library.query.set(query);
+  }
+}
