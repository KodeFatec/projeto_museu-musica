@@ -0,0 +1,64 @@
+import { computed, inject, Injectable, signal } from '@angular/core';
+import { Instrument } from '../models/instrument.model';
+import { normalize } from '../utils/text';
+import { ExploreService } from './explore.service';
+import { LibraryService } from './library.service';
+
+export type InstrumentSort = 'name' | 'oldest' | 'newest' | 'maker';
+export type InstrumentView = 'list' | 'grid';
+
+/**
+ * Estado da tela Instrumentos: filtro por tipo, busca (a mesma do menu), ordem e modo de exibição.
+ * Os instrumentos em si são carregados pelo ExploreService (mesma rota, uma só chamada).
+ */
+@Injectable({ providedIn: 'root' })
+export class InstrumentsService {
+  private readonly explore = inject(ExploreService);
+  private readonly library = inject(LibraryService);
+
+  readonly type = signal<string | null>(null);
+  readonly sort = signal<InstrumentSort>('name');
+  readonly view = signal<InstrumentView>('list');
+
+  readonly status = this.explore.status;
+  readonly error = this.explore.error;
+  readonly all = this.explore.instruments;
+  readonly types = this.explore.instrumentTypes;
+
+  /** Ano de fabricação do instrumento mais antigo do acervo. */
+  readonly oldestYear = computed(() => {
+    const years = this.all().map((i) => i.year).filter((y): y is number => !!y);
+    return years.length ? Math.min(...years) : null;
+  });
+
+  readonly filtered = computed<Instrument[]>(() => {
+    const type = this.type();
+    const text = normalize(this.library.query().trim());
+    const items = this.all().filter(
+      (i) =>
+        (!type || i.type === type) &&
+        (!text || normalize([i.title, i.type, i.maker, i.formerOwner, i.description, i.origin, i.year].filter(Boolean).join(' ')).includes(text)),
+    );
+    return items.sort(this.comparator(this.sort()));
+  });
+
+  load(): Promise<void> {
+    return this.explore.load();
+  }
+
+  private comparator(sort: InstrumentSort): (a: Instrument, b: Instrument) => number {
+    const byName = (a: Instrument, b: Instrument) => a.title.localeCompare(b.title, 'pt-BR');
+    // sem ano de fabricação vai para o fim, em qualquer ordem
+    const year = (i: Instrument, missing: number) => i.year ?? missing;
+    switch (sort) {
+      case 'oldest':
+        return (a, b) => year(a, Infinity) - year(b, Infinity) || byName(a, b);
+      case 'newest':
+        return (a, b) => year(b, -Infinity) - year(a, -Infinity) || byName(a, b);
+      case 'maker':
+        return (a, b) => (a.maker ?? '\uffff').localeCompare(b.maker ?? '\uffff', 'pt-BR') || byName(a, b);
+      default:
+        return byName;
+    }
+  }
+}
