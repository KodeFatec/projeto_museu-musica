+<div class="page">
+  <!-- mobile: marca e perfil (no desktop isso fica no menu) -->
+  <app-mobile-head />
+
+  <section class="hero">
+    <div class="hero__text">
+      <p class="crumbs">Museu da Música Itu <i>/</i> Acervo <i>/</i> <strong>Instrumentos</strong></p>
+      <p class="eyebrow">Coleção organológica • Timbres históricos</p>
+      <h1>Instrumentos do Acervo</h1>
+      <p class="lead">
+        Instrumentos originais preservados pelo museu, catalogados com tipo, fabricante, ano de fabricação e estado de conservação.
+      </p>
+    </div>
+
+    <dl class="stats">
+      <div>
+        <dd>{{ instruments.all().length }}</dd>
+        <dt>Instrumentos catalogados</dt>
+      </div>
+      <div>
+        <dd>{{ instruments.types().length }}</dd>
+        <dt>Tipos de instrumento</dt>
+      </div>
+      @if (instruments.oldestYear(); as year) {
+        <div>
+          <dd>{{ year }}</dd>
+          <dt>Fabricação mais antiga</dt>
+        </div>
+      }
+    </dl>
+  </section>
+
+  <app-filter-chips label="Tipo de instrumento" [options]="chips()" [value]="instruments.type() ?? 'all'" (valueChange)="onType($event)" />
+
+  <div class="toolbar">
+    <app-search-field
+      class="toolbar__search"
+      placeholder="Buscar por instrumento, fabricante, ano ou antigo dono..."
+      [value]="library.query()"
+      (valueChange)="onSearch($event)"
+    />
+    <label class="sort">
+      <span class="sr-only">Ordenar por</span>
+      <select [value]="instruments.sort()" (change)="onSort($event)">
+        @for (sort of sorts; track sort.id) {
+          <option [value]="sort.id" [selected]="sort.id === instruments.sort()">{{ sort.label }}</option>
+        }
+      </select>
+    </label>
+    <div class="views" role="group" aria-label="Modo de exibição">
+      @for (view of views; track view.id) {
+        <button type="button" [class.on]="instruments.view() === view.id" [attr.aria-pressed]="instruments.view() === view.id" (click)="instruments.view.set(view.id)">
+          {{ view.label }}
+        </button>
+      }
+    </div>
+  </div>
+
+  @if (instruments.status() === 'error') {
+    <div class="state">
+      <p>{{ instruments.error() }}</p>
+      <button type="button" (click)="home.reload()">Tentar novamente</button>
+    </div>
+  } @else if (instruments.status() === 'loading') {
+    <p class="state">Carregando o acervo…</p>
+  } @else if (instruments.filtered().length === 0) {
+    <p class="state">
+      {{ instruments.all().length ? 'Nenhum instrumento encontrado para esta busca.' : 'Nenhum instrumento cadastrado no acervo ainda.' }}
+    </p>
+  }
+
+  <ul class="list" [class.list--grid]="instruments.view() === 'grid'">
+    @for (instrument of instruments.filtered(); track instrument.id) {
+      <li><app-instrument-card [instrument]="instrument" [view]="instruments.view()" /></li>
+    }
+  </ul>
+
+  @if (home.museum(); as museum) {
+    <app-museum-banner [museum]="museum" [rooms]="home.rooms()" [capacity]="home.totalCapacity()" />
+  }
+</div>
